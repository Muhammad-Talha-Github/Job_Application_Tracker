# Copy this file to .env and replace the username/password with your local PostgreSQL values.
DATABASE_URL=postgresql+psycopg://postgres:your_password@127.0.0.1:5432/job_tracker
JWT_SECRET_KEY=replace_with_a_random_secret_of_at_least_32_characters
ACCESS_TOKEN_MINUTES=30

# Only needed once when migrating existing application rows to their owner.
LEGACY_OWNER_EMAIL=owner@example.com
LEGACY_OWNER_PASSWORD=choose_a_private_password_of_at_least_12_characters
