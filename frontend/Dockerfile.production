# Build the Vite bundle with the public API URL supplied by Compose.
FROM node:22-alpine AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .

ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
RUN npm run build

# Serve only the static build; no development/preview server is used in this image.
FROM busybox:1.37.0
COPY --from=build /app/dist /www
EXPOSE 5173
CMD ["httpd", "-f", "-p", "5173", "-h", "/www"]
