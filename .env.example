# These defaults are only for local Docker Compose development.
POSTGRES_DB=job_tracker
POSTGRES_USER=job_tracker
POSTGRES_PASSWORD=local_tracker_password
POSTGRES_HOST_PORT=5433
JWT_SECRET_KEY=local_docker_development_secret_change_before_sharing_123456
ACCESS_TOKEN_MINUTES=30

# The browser reaches the published backend port on the host machine.
VITE_API_BASE_URL=http://localhost:8000
