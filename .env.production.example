# Copy to .env.production on the EC2 host and replace every blank value.
POSTGRES_DB=job_tracker
POSTGRES_USER=job_tracker_app
POSTGRES_PASSWORD=

# Must use the same database, user, and password set above. Use postgres as host.
DATABASE_URL=
JWT_SECRET_KEY=
ACCESS_TOKEN_MINUTES=30

# Set this to the exact public frontend origin, with scheme and no trailing slash.
FRONTEND_ORIGINS=

# Set this to the browser-reachable API URL. The address is configured on the host,
# never committed into application source code.
VITE_API_BASE_URL=
